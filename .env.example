# Copy this file to .env and fill in your own values before deploying.
PORT=8787
JWT_SECRET=change-this-to-a-long-random-string

# Only used the very first time the app starts, to create the initial
# admin account (name "Admin"). Change it, then sign in and set your own
# PIN / add real agents from the Agents tab.
DEFAULT_ADMIN_PIN=1234
